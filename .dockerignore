# Used for builds whose context is the repo root — désormais les deux front
# (pwa-dashboard/Dockerfile et pwa-counter/Dockerfile), qui ont chacun besoin
# de leur dossier applicatif ET de shared/ dans un même contexte. Garde
# l'upload de contexte léger.

# Android app
app/
gradle/
gradle.properties
gradlew.bat
build.gradle
settings.gradle

# IDE / VCS
.git
.idea

# Python virtualenvs (backend has its own .dockerignore for its own build context)
.venv/
backend/.venv/

# Legacy web assets not needed by any container build
docs/
workers/

# Build artifacts / deps — each app installs/builds its own inside the image
**/node_modules
**/dist
**/__pycache__
**/.pytest_cache
**/.ruff_cache
